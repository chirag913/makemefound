# Postgres connection string (Supabase, Neon, or any Postgres provider).
DATABASE_URL=postgres://user:password@host:5432/database

# Resend API key for the audit-request notification email.
RESEND_API_KEY=

# Verified sender address in Resend. Falls back to onboarding@resend.dev if unset.
RESEND_FROM_EMAIL=MakeMeFound <notifications@makemefound.com>

# Google Analytics 4 measurement ID (public — safe to expose client-side).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
