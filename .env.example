# Optional: Postgres connection string (Supabase, Neon, or any Postgres provider).
# Leave unset to skip database storage entirely (e.g. if you're only using the
# Google Sheet webhook below).
DATABASE_URL=

# Google Apps Script Web App URL that appends audit requests to a Google Sheet and
# emails hello@makemefound.com. See google-apps-script/Code.gs for the script and
# setup steps (create a Sheet, paste the script, deploy as a Web App, paste the URL here).
GOOGLE_SHEET_WEBHOOK_URL=

# Optional: Resend API key for the audit-request notification email.
RESEND_API_KEY=

# Verified sender address in Resend. Falls back to onboarding@resend.dev if unset.
RESEND_FROM_EMAIL=MakeMeFound <notifications@makemefound.com>

# Google Analytics 4 measurement ID (public — safe to expose client-side).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
