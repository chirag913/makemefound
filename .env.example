# --- Enquiry form ---------------------------------------------------------------
# Primary: every enquiry is emailed to you through Resend (https://resend.com).
# 1. Create a Resend account and an API key (Sending access is enough).
RESEND_API_KEY=
# 2. Who receives enquiries. Comma-separate for several. Defaults to chirag@getmakemefound.com.
LEAD_NOTIFICATION_EMAIL=
# 3. Sender. Leave empty to use onboarding@resend.dev, which ONLY delivers to the email
#    address that owns your Resend account. To send to any address, verify a domain in
#    Resend (e.g. getmakemefound.com) and set something like:
#    RESEND_FROM_EMAIL=MakeMeFound <leads@getmakemefound.com>
RESEND_FROM_EMAIL=

# Optional extras — skipped entirely when empty.
# Google Apps Script Web App URL (ends in /exec). See google-apps-script/Code.gs.
GOOGLE_SHEET_WEBHOOK_URL=
# Postgres connection string (Supabase, Neon, …).
DATABASE_URL=

# Google Analytics 4 measurement ID (public — safe to expose client-side).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
